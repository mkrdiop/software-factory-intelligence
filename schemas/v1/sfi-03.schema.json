{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sfi:schema:v1:sfi-03",
  "title": "SFI-03 Canonical Engineering Evidence and Dataset Model",
  "description": "Structural union schema for SFI-03 record families. Semantic, authorization and governance validation are separate stages.",
  "oneOf": [
    {
      "$ref": "#/$defs/evidenceRecord"
    },
    {
      "$ref": "#/$defs/evidenceRelationship"
    },
    {
      "$ref": "#/$defs/evaluationResult"
    },
    {
      "$ref": "#/$defs/datasetDefinition"
    },
    {
      "$ref": "#/$defs/datasetRelease"
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerTenantId",
        "classification",
        "rights",
        "permittedPurposes",
        "sharingScope",
        "retention"
      ],
      "properties": {
        "ownerTenantId": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "basis"
          ],
          "properties": {
            "status": {
              "enum": [
                "cleared",
                "restricted",
                "unknown",
                "revoked"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1
            },
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "restrictions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "permittedPurposes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "engineering-operations",
              "analytics",
              "evaluation",
              "benchmarking",
              "retrieval",
              "model-development",
              "model-training",
              "product-improvement",
              "security-investigation"
            ]
          }
        },
        "sharingScope": {
          "enum": [
            "tenant-only",
            "workspace-only",
            "explicit-grant",
            "public"
          ]
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policyId"
          ],
          "properties": {
            "policyId": {
              "type": "string",
              "minLength": 1
            },
            "retainUntil": {
              "$ref": "#/$defs/dateTime"
            },
            "legalHold": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "service",
            "agent",
            "system",
            "unknown"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string"
        },
        "organizationRef": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "instanceId",
        "objectType",
        "objectId"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "instanceId": {
          "type": "string",
          "minLength": 1
        },
        "objectType": {
          "type": "string",
          "minLength": 1
        },
        "objectId": {
          "type": "string",
          "minLength": 1
        },
        "objectVersion": {
          "type": "string",
          "minLength": 1
        },
        "eventId": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "trust",
        "producer",
        "mappingVersion",
        "capturedAt"
      ],
      "properties": {
        "origin": {
          "enum": [
            "source-observed",
            "source-derived",
            "sfi-normalized",
            "sfi-derived",
            "model-generated",
            "human-authored"
          ]
        },
        "trust": {
          "enum": [
            "unverified",
            "source-authenticated",
            "human-reviewed",
            "independently-verified",
            "disputed"
          ]
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "connectorId": {
          "type": "string",
          "minLength": 1
        },
        "connectorVersion": {
          "type": "string",
          "minLength": 1
        },
        "mappingVersion": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "capturedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "derivation": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mediaType",
        "digest",
        "archiveRef"
      ],
      "properties": {
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "archiveRef": {
          "type": "string",
          "minLength": 1
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "redacted": {
          "type": "boolean"
        }
      }
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "recordType",
        "evidenceId",
        "tenantId",
        "workspaceId",
        "evidenceDomain",
        "evidenceType",
        "captureMode",
        "source",
        "temporal",
        "provenance",
        "payload",
        "content",
        "governance",
        "idempotencyKey"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "recordType": {
          "const": "engineering-evidence"
        },
        "evidenceId": {
          "$ref": "#/$defs/uuid"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "evidenceDomain": {
          "enum": [
            "intent",
            "reasoning",
            "execution",
            "validation",
            "outcome",
            "learning"
          ]
        },
        "evidenceType": {
          "type": "string",
          "minLength": 1
        },
        "captureMode": {
          "enum": [
            "event",
            "snapshot",
            "document",
            "trace-summary",
            "derived-assertion"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "temporal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observedAt",
            "ingestedAt"
          ],
          "properties": {
            "occurredAt": {
              "$ref": "#/$defs/dateTime"
            },
            "observedAt": {
              "$ref": "#/$defs/dateTime"
            },
            "ingestedAt": {
              "$ref": "#/$defs/dateTime"
            },
            "effectiveAt": {
              "$ref": "#/$defs/dateTime"
            },
            "sourceUpdatedAt": {
              "$ref": "#/$defs/dateTime"
            }
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "payload": {
          "$ref": "#/$defs/payload"
        },
        "content": {
          "type": "object"
        },
        "governance": {
          "$ref": "#/$defs/governance"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        },
        "supersedesEvidenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uuid"
          },
          "uniqueItems": true
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "evidence",
            "external"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceSystem": {
          "type": "string",
          "minLength": 1
        },
        "sourceInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "objectType": {
          "type": "string",
          "minLength": 1
        },
        "objectId": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "evidence"
              }
            }
          },
          "then": {
            "required": [
              "id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "external"
              }
            }
          },
          "then": {
            "required": [
              "sourceSystem",
              "sourceInstanceId",
              "objectType",
              "objectId"
            ]
          }
        }
      ]
    },
    "evidenceRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "recordType",
        "relationshipId",
        "tenantId",
        "workspaceId",
        "subject",
        "predicate",
        "target",
        "status",
        "assertion",
        "evidenceBasis",
        "assertedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "recordType": {
          "const": "evidence-relationship"
        },
        "relationshipId": {
          "$ref": "#/$defs/uuid"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "$ref": "#/$defs/endpoint"
        },
        "predicate": {
          "enum": [
            "supports",
            "implements",
            "validates",
            "contradicts",
            "supersedes",
            "derived-from",
            "references",
            "blocks",
            "caused-by",
            "belongs-to",
            "produced-by",
            "reviewed-by"
          ]
        },
        "target": {
          "$ref": "#/$defs/endpoint"
        },
        "status": {
          "enum": [
            "candidate",
            "asserted",
            "verified",
            "rejected",
            "superseded"
          ]
        },
        "assertion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "producer"
          ],
          "properties": {
            "method": {
              "enum": [
                "source-native",
                "deterministic-rule",
                "human",
                "model"
              ]
            },
            "producer": {
              "type": "string",
              "minLength": 1
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "confidenceMethod": {
              "type": "string",
              "minLength": 1
            },
            "actor": {
              "$ref": "#/$defs/actor"
            }
          }
        },
        "evidenceBasis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "assertedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "reviewedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "reviewedBy": {
          "$ref": "#/$defs/actor"
        },
        "supersedesRelationshipId": {
          "$ref": "#/$defs/uuid"
        },
        "governance": {
          "$ref": "#/$defs/governance"
        }
      }
    },
    "evaluationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "recordType",
        "evaluationId",
        "tenantId",
        "workspaceId",
        "evaluator",
        "temporal",
        "status",
        "inputs",
        "criteria",
        "summary",
        "reproducibility",
        "governance"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "recordType": {
          "const": "evaluation-result"
        },
        "evaluationId": {
          "$ref": "#/$defs/uuid"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evaluatorId",
            "version",
            "profileId",
            "profileVersion"
          ],
          "properties": {
            "evaluatorId": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "profileId": {
              "type": "string",
              "minLength": 1
            },
            "profileVersion": {
              "type": "string",
              "minLength": 1
            },
            "artifactDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "temporal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startedAt",
            "completedAt"
          ],
          "properties": {
            "startedAt": {
              "$ref": "#/$defs/dateTime"
            },
            "completedAt": {
              "$ref": "#/$defs/dateTime"
            }
          }
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "incomplete"
          ]
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidenceIds",
            "snapshotDigest",
            "configurationDigest"
          ],
          "properties": {
            "evidenceIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/uuid"
              },
              "uniqueItems": true
            },
            "relationshipIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/uuid"
              },
              "uniqueItems": true
            },
            "snapshotDigest": {
              "$ref": "#/$defs/digest"
            },
            "configurationDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterionId",
              "outcome"
            ],
            "properties": {
              "criterionId": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "enum": [
                  "pass",
                  "fail",
                  "warning",
                  "not-applicable",
                  "indeterminate"
                ]
              },
              "measuredValue": {},
              "unit": {
                "type": "string"
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/uuid"
                },
                "uniqueItems": true
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "pass",
                "fail",
                "warning",
                "indeterminate"
              ]
            },
            "score": {
              "type": "number"
            },
            "scoreScale": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        },
        "reproducibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deterministic",
            "environment"
          ],
          "properties": {
            "deterministic": {
              "type": "boolean"
            },
            "seed": {
              "type": [
                "integer",
                "string"
              ]
            },
            "environment": {
              "type": "string",
              "minLength": 1
            },
            "modelId": {
              "type": "string"
            },
            "modelVersion": {
              "type": "string"
            },
            "toolchainDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "governance": {
          "$ref": "#/$defs/governance"
        }
      }
    },
    "datasetDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "recordType",
        "datasetId",
        "definitionVersion",
        "name",
        "purpose",
        "selection",
        "transformations",
        "targetUses",
        "qualityGates",
        "governance"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "recordType": {
          "const": "dataset-definition"
        },
        "datasetId": {
          "type": "string",
          "minLength": 1
        },
        "definitionVersion": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tenantIds",
            "evidenceDomains"
          ],
          "properties": {
            "tenantIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "workspaceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "evidenceDomains": {
              "type": "array",
              "items": {
                "enum": [
                  "intent",
                  "reasoning",
                  "execution",
                  "validation",
                  "outcome",
                  "learning"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "evidenceTypes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "from": {
              "$ref": "#/$defs/dateTime"
            },
            "to": {
              "$ref": "#/$defs/dateTime"
            },
            "includeEvidenceIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/uuid"
              },
              "uniqueItems": true
            },
            "excludeEvidenceIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/uuid"
              },
              "uniqueItems": true
            },
            "filterExpression": {
              "type": "object"
            }
          }
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "transformId",
              "version"
            ],
            "properties": {
              "transformId": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "configurationDigest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        "labelSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "targetUses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "analytics",
              "evaluation",
              "benchmarking",
              "retrieval",
              "model-development",
              "model-training"
            ]
          }
        },
        "qualityGates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "governance": {
          "$ref": "#/$defs/governance"
        }
      }
    },
    "datasetRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "recordType",
        "releaseId",
        "tenantId",
        "datasetId",
        "definitionVersion",
        "releaseVersion",
        "builderVersion",
        "createdAt",
        "status",
        "itemCount",
        "items",
        "lineage",
        "quality",
        "contentDigest",
        "governance"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "recordType": {
          "const": "dataset-release"
        },
        "releaseId": {
          "$ref": "#/$defs/uuid"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "datasetId": {
          "type": "string",
          "minLength": 1
        },
        "definitionVersion": {
          "type": "string",
          "minLength": 1
        },
        "releaseVersion": {
          "type": "string",
          "minLength": 1
        },
        "builderVersion": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "$ref": "#/$defs/dateTime"
        },
        "status": {
          "enum": [
            "building",
            "validated",
            "approved",
            "published",
            "failed"
          ]
        },
        "itemCount": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidenceId",
              "contentDigest"
            ],
            "properties": {
              "evidenceId": {
                "$ref": "#/$defs/uuid"
              },
              "contentDigest": {
                "$ref": "#/$defs/digest"
              },
              "split": {
                "enum": [
                  "train",
                  "validation",
                  "test",
                  "holdout",
                  "unspecified"
                ]
              },
              "labels": {
                "type": "object"
              },
              "redactionProfile": {
                "type": "string"
              }
            }
          }
        },
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidenceSnapshotDigest",
            "transformationVersions"
          ],
          "properties": {
            "evidenceSnapshotDigest": {
